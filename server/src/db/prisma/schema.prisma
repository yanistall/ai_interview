generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ENTERPRISE
  ADMIN
}

enum Persona {
  FRIENDLY_HR
  STRICT_MANAGER
  TECHNICAL_LEAD
  EXECUTIVE
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  passwordHash   String
  name           String
  companyName    String?
  resumeFileName String?
  resumeMimeType String?
  resumeData     String?
  role           Role              @default(CANDIDATE)
  resetToken     String?
  resetTokenExp  DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  jobs           JobProfile[]
  reports        InterviewReport[]
  videoUploads   VideoUpload[]

  @@index([closedAt])
}

model JobProfile {
  id          String            @id @default(uuid())
  companyName String
  title       String
  description String
  persona     Persona
  voiceName   String
  questions   String[]
  createdAt   DateTime          @default(now())
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  reports     InterviewReport[]
}

model InterviewReport {
  id                String       @id @default(uuid())
  timestamp         DateTime     @default(now())
  candidateName     String
  jobTitle          String
  videoPath         String?
  fullTranscript    Json
  assessmentVersion String
  assessment        Json
  candidateId       String?
  candidate         User?        @relation(fields: [candidateId], references: [id])
  jobProfileId      String?
  jobProfile        JobProfile?  @relation(fields: [jobProfileId], references: [id])
  videoUpload       VideoUpload?
}

model VideoUpload {
  filename   String           @id
  uploaderId String
  reportId   String?          @unique
  uploadedAt DateTime         @default(now())
  uploader   User             @relation(fields: [uploaderId], references: [id])
  report     InterviewReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([uploadedAt])
}
